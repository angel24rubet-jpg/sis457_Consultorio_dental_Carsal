@model IEnumerable<WebCarsal.Models.Paciente>

@{
    ViewData["Title"] = "Pacientes";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

<div class="container-fluid py-3">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-semibold mb-1" style="color:#164B50;">
                <i class="bi bi-people me-2"></i>Pacientes
            </h2>
            <p class="text-muted mb-0">Administración y registro de pacientes</p>
        </div>

        <button type="button" class="btn text-white px-4 py-2"
                style="background:#176B68;"
                id="btnNuevoPaciente"
                data-url="@Url.Action("Create", "Pacientes")">
            <i class="bi bi-person-plus me-2"></i>Nuevo paciente
        </button>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get">
                <div class="row g-2 align-items-center">
                    <div class="col-md-9">
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-search" style="color:#176B68;"></i>
                            </span>
                            <input type="text" name="buscar" value="@ViewBag.Buscar"
                                   class="form-control"
                                   placeholder="Buscar por CI, nombres o apellidos..." />
                        </div>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn text-white flex-grow-1"
                                style="background:#176B68;">
                            Buscar
                        </button>
                        <a asp-action="Index" class="btn btn-light border">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-semibold mb-1" style="color:#164B50;">
                        Listado de pacientes
                    </h5>
                    <small class="text-muted">Pacientes activos registrados</small>
                </div>
                <span class="badge rounded-pill px-3 py-2"
                      style="background:#D9F3F0;color:#176B68;">
                    @Model.Count() pacientes
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead style="background:#F1F7F6;">
                        <tr>
                            <th class="ps-4">CI</th>
                            <th>Nombres</th>
                            <th>Primer apellido</th>
                            <th>Segundo apellido</th>
                            <th>Fecha de nacimiento</th>
                            <th>Celular de referencia</th>
                            <th>Dirección</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var paciente in Model)
                        {
                            <tr>
                                <td class="ps-4">@paciente.Ci</td>
                                <td class="fw-semibold" style="color:#164B50;">@paciente.Nombres</td>
                                <td>@(string.IsNullOrWhiteSpace(paciente.PrimerApellido) ? "—" : paciente.PrimerApellido)</td>
                                <td>@(string.IsNullOrWhiteSpace(paciente.SegundoApellido) ? "—" : paciente.SegundoApellido)</td>
                                <td>@(paciente.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "No registrado")</td>
                                <td>@(string.IsNullOrWhiteSpace(paciente.Celular) ? "No registrado" : paciente.Celular)</td>
                                <td>@(string.IsNullOrWhiteSpace(paciente.Direccion) ? "No registrada" : paciente.Direccion)</td>
                                <td>
                                    <span class="badge rounded-pill"
                                          style="background:#D9F3F0;color:#176B68;">
                                        Activo
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-sm btn-light border me-1 btn-editar-paciente"
                                            data-url="@Url.Action("Edit", "Pacientes", new { id = paciente.Id })"
                                            title="Editar">
                                        <i class="bi bi-pencil-square" style="color:#176B68;"></i>
                                    </button>

                                    <form asp-action="CambiarEstado"
                                          asp-route-id="@paciente.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('¿Desea desactivar este paciente?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-light border"
                                                title="Desactivar">
                                            <i class="bi bi-person-x text-danger"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5">
                                    <i class="bi bi-people display-5 d-block mb-3"
                                       style="color:#9BCBC5;"></i>
                                    <h6 class="text-muted">No se encontraron pacientes</h6>
                                    <small class="text-muted">Registre un nuevo paciente o modifique la búsqueda.</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="modalPaciente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 shadow" id="contenidoModalPaciente">
        </div>
    </div>
</div>

<!-- NOTIFICACIONES -->
<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="toastPaciente" class="toast border-0 shadow">
        <div class="d-flex align-items-center p-2">
            <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
            <div class="toast-body" id="mensajeToastPaciente"></div>
            <button type="button" class="btn-close me-2" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const modalElemento = document.getElementById("modalPaciente");
            const contenidoModal = document.getElementById("contenidoModalPaciente");

            function inicializarCalendario() {
                const campo = contenidoModal.querySelector(".fecha-paciente");

                if (!campo) return;

                if (campo._flatpickr) {
                    campo._flatpickr.destroy();
                }

                flatpickr(campo, {
                    locale: "es",
                    dateFormat: "d/m/Y",
                    allowInput: true,
                    maxDate: new Date().fp_incr(-365 * 5),
                    disableMobile: true,
                    monthSelectorType: "static",
                    yearSelectorType: "dropdown"
                });
            }

            function mostrarToast(mensaje) {
                document.getElementById("mensajeToastPaciente").textContent = mensaje;
                bootstrap.Toast.getOrCreateInstance(
                    document.getElementById("toastPaciente")
                ).show();
            }

            async function abrirModal(url) {
                contenidoModal.innerHTML = `
                    <div class="modal-body text-center p-5">
                        <div class="spinner-border" style="color:#176B68;"></div>
                        <p class="text-muted mt-3">Cargando formulario...</p>
                    </div>`;

                bootstrap.Modal.getOrCreateInstance(modalElemento).show();

                try {
                    const respuesta = await fetch(url);

                    if (!respuesta.ok) {
                        throw new Error("Error al cargar el formulario: " + respuesta.status);
                    }

                    contenidoModal.innerHTML = await respuesta.text();

                    inicializarCalendario();
                    configurarFormulario();

                } catch (error) {
                    contenidoModal.innerHTML = `
                        <div class="modal-header">
                            <h5 class="modal-title text-danger">Error</h5>
                            <button type="button" class="btn-close"
                                    data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">${error.message}</div>`;
                }
            }

            function configurarFormulario() {
                const formulario = contenidoModal.querySelector("form");

                if (!formulario) return;

                formulario.addEventListener("submit", async function (e) {
                    e.preventDefault();

                    const boton = formulario.querySelector('button[type="submit"]');
                    const textoOriginal = boton.innerHTML;

                    boton.disabled = true;
                    boton.innerHTML =
                        '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';

                    try {
                        const respuesta = await fetch(formulario.action, {
                            method: "POST",
                            body: new FormData(formulario)
                        });

                        const tipo = respuesta.headers.get("content-type") || "";

                        if (tipo.includes("application/json")) {
                            const resultado = await respuesta.json();

                            if (resultado.success) {
                                bootstrap.Modal.getOrCreateInstance(modalElemento).hide();
                                mostrarToast(resultado.mensaje);
                                setTimeout(() => window.location.reload(), 900);
                                return;
                            }
                        }

                        contenidoModal.innerHTML = await respuesta.text();
                        inicializarCalendario();
                        configurarFormulario();

                    } catch (error) {
                        alert("No se pudo guardar el paciente.");
                        boton.disabled = false;
                        boton.innerHTML = textoOriginal;
                    }
                });
            }

            document.getElementById("btnNuevoPaciente")
                .addEventListener("click", function () {
                    abrirModal(this.dataset.url);
                });

            document.querySelectorAll(".btn-editar-paciente")
                .forEach(function (boton) {
                    boton.addEventListener("click", function () {
                        abrirModal(this.dataset.url);
                    });
                });
        });
    </script>
}
@model IEnumerable<WebCarsal.Models.HistorialClinico>

@{
    ViewData["Title"] = "Historial clínico";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-journal-medical"></i> Historial clínico</h2>
            <p class="text-muted mb-0">Registros de atención de los pacientes</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nueva atención
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha de atención</th>
                            <th>Paciente</th>
                            <th>CI</th>
                            <th>Diagnóstico</th>
                            <th>Tratamiento</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var historial in Model)
                            {
                                <tr>
                                    <td>@historial.FechaAtencion.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @historial.IdPacienteNavigation.Nombres
                                        @historial.IdPacienteNavigation.PrimerApellido
                                        @historial.IdPacienteNavigation.SegundoApellido
                                    </td>
                                    <td>@historial.IdPacienteNavigation.Ci</td>
                                    <td>@historial.Diagnostico</td>
                                    <td>@historial.Tratamiento</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@historial.Id"
                                           class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@historial.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No existen historiales clínicos registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

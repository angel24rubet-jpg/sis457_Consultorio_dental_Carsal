@model WebCarsal.Models.Cita

@{
    ViewData["Title"] = "Detalles de la cita";
}

<div class="container-fluid">
    <div class="mb-4">
        <h2><i class="bi bi-calendar-check"></i> Detalles de la cita</h2>
        <p class="text-muted">Información de la cita registrada.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <dl class="row">
                <dt class="col-md-3">Paciente</dt>
                <dd class="col-md-9">
                    @Model.IdPacienteNavigation.Nombres
                    @Model.IdPacienteNavigation.PrimerApellido
                    @Model.IdPacienteNavigation.SegundoApellido
                </dd>

                <dt class="col-md-3">Doctor</dt>
                <dd class="col-md-9">
                    Dr. @Model.IdDoctorNavigation.Nombres
                    @Model.IdDoctorNavigation.Apellidos
                </dd>

                <dt class="col-md-3">Especialidad</dt>
                <dd class="col-md-9">@Model.IdDoctorNavigation.IdEspecialidadNavigation.Nombre</dd>

                <dt class="col-md-3">Fecha</dt>
                <dd class="col-md-9">@Model.FechaHora.ToString("dd/MM/yyyy")</dd>

                <dt class="col-md-3">Hora</dt>
                <dd class="col-md-9">@Model.FechaHora.ToString("HH:mm")</dd>

                <dt class="col-md-3">Estado</dt>
                <dd class="col-md-9">
                    @if (Model.Estado == "Pendiente")
                    {
                        <span class="badge bg-warning text-dark">Pendiente</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Atendida</span>
                    }
                </dd>

                <dt class="col-md-3">Fecha de registro</dt>
                <dd class="col-md-9">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>
            </dl>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-secondary">Volver</a>

                @if (Model.Estado == "Pendiente")
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil"></i> Editar cita
                    </a>
                }
            </div>
        </div>
    </div>
</div>

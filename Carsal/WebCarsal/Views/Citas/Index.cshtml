@model IEnumerable<WebCarsal.Models.Cita>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdPaciente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdDoctor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaHora)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioRegistro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaRegistro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioModificacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaModificacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HistorialClinico)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdDoctorNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdPacienteNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioModificacionNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioRegistroNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pago)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.IdPaciente)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdDoctor)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaHora)
            </td>
            <td>
                @Html.DisplayFor(model => item.Estado)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdUsuarioRegistro)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaRegistro)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdUsuarioModificacion)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaModificacion)
            </td>
            <td>
                @Html.DisplayFor(model => item.HistorialClinico)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdDoctorNavigation)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdPacienteNavigation)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdUsuarioModificacionNavigation)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdUsuarioRegistroNavigation)
            </td>
            <td>
                @Html.DisplayFor(model => item.Pago)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

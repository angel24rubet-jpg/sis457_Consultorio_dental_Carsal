@model WebCarsal.Models.Especialidad

@{
    ViewData["Title"] = "Desactivar especialidad";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Desactivar especialidad</h2>
            <p class="text-muted mb-0">
                Revise la información antes de confirmar la desactivación.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                ¿Está seguro de que desea desactivar esta especialidad?
                El registro no será eliminado de la base de datos.
            </div>

            <h5 class="fw-bold mb-4">
                <i class="bi bi-grid-fill text-primary me-2"></i>
                Información de la especialidad
            </h5>

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label text-muted">Nombre</label>
                    <p class="fw-semibold">@Model.Nombre</p>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted">Estado actual</label>
                    <p>
                        <span class="badge bg-success">Activa</span>
                    </p>
                </div>

                <div class="col-md-12">
                    <label class="form-label text-muted">Descripción</label>
                    <p>@(Model.Descripcion ?? "Sin descripción")</p>
                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted">Fecha de registro</label>
                    <p>@Model.FechaRegistro.ToString("dd/MM/yyyy")</p>
                </div>

            </div>

            <hr class="my-4" />

            <form asp-action="Delete" method="post">

                <input type="hidden" name="id" value="@Model.Id" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index" class="btn btn-light border">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-x-circle-fill me-1"></i>
                        Confirmar desactivación
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@model IEnumerable<WebCarsal.Models.Especialidad>

@{
    ViewData["Title"] = "Especialidades";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Gestión de especialidades</h2>
            <p class="text-muted mb-0">
                Administración de las especialidades médicas de la clínica
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-3 py-2">
            <i class="bi bi-plus-circle-fill me-1"></i>
            Registrar especialidad
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- BUSCADOR -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get">
                <div class="row g-2 align-items-end">

                    <div class="col-md-10">
                        <label class="form-label fw-semibold">
                            Buscar especialidad
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="buscar"
                                   value="@ViewData["Buscar"]"
                                   class="form-control"
                                   placeholder="Ingrese el nombre de la especialidad..." />
                        </div>
                    </div>

                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-primary">
                            Buscar
                        </button>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- TABLA -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-grid-fill text-primary me-2"></i>
                Lista de especialidades activas
            </h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th>Fecha registro</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var especialidad in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @especialidad.Nombre
                                    </td>

                                    <td>
                                        @(especialidad.Descripcion ?? "—")
                                    </td>

                                    <td>
                                        <span class="badge bg-success">
                                            Activa
                                        </span>
                                    </td>

                                    <td>
                                        @especialidad.FechaRegistro.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@especialidad.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="Ver detalles">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@especialidad.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Modificar">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@especialidad.Id"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Desactivar">
                                                <i class="bi bi-x-circle-fill"></i>
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="bi bi-grid text-muted fs-1"></i>

                                    <p class="fw-semibold mt-2 mb-1">
                                        No se encontraron especialidades
                                    </p>

                                    <p class="text-muted mb-0">
                                        Registre una especialidad o intente otra búsqueda.
                                    </p>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        </div>

        <div class="card-footer bg-white text-muted">
            Total de especialidades encontradas:
            <strong>@Model.Count()</strong>
        </div>

    </div>

</div>

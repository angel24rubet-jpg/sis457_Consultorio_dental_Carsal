@model WebCarsal.Models.Pago

@{
    ViewData["Title"] = "Detalles del pago";
}

<div class="container-fluid">
    <div class="mb-4">
        <h2><i class="bi bi-receipt"></i> Detalles del pago</h2>
        <p class="text-muted">Información del cobro y los servicios registrados.</p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="mb-3">Información del paciente</h5>

            <dl class="row">
                <dt class="col-md-3">Paciente</dt>
                <dd class="col-md-9">
                    @Model.IdCitaNavigation.IdPacienteNavigation.Nombres
                    @Model.IdCitaNavigation.IdPacienteNavigation.PrimerApellido
                    @Model.IdCitaNavigation.IdPacienteNavigation.SegundoApellido
                </dd>

                <dt class="col-md-3">Carnet de identidad</dt>
                <dd class="col-md-9">
                    @Model.IdCitaNavigation.IdPacienteNavigation.Ci
                </dd>
            </dl>

            <hr />

            <h5 class="mb-3">Información de la cita</h5>

            <dl class="row">
                <dt class="col-md-3">Número de cita</dt>
                <dd class="col-md-9">@Model.IdCita</dd>

                <dt class="col-md-3">Fecha de cita</dt>
                <dd class="col-md-9">
                    @Model.IdCitaNavigation.FechaHora.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-md-3">Doctor</dt>
                <dd class="col-md-9">
                    Dr. @Model.IdCitaNavigation.IdDoctorNavigation.Nombres
                    @Model.IdCitaNavigation.IdDoctorNavigation.Apellidos
                </dd>
            </dl>

            <hr />

            <h5 class="mb-3">Detalle de servicios</h5>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Servicio</th>
                            <th>Precio unitario</th>
                            <th>Cantidad</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detalle in Model.DetallePago)
                        {
                            <tr>
                                <td>@detalle.IdServicioNavigation.Nombre</td>
                                <td>Bs @detalle.PrecioUnitario.ToString("N2")</td>
                                <td>@detalle.Cantidad</td>
                                <td>Bs @detalle.Subtotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">TOTAL</th>
                            <th>Bs @Model.Monto.ToString("N2")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <hr />

            <h5 class="mb-3">Información del pago</h5>

            <dl class="row">
                <dt class="col-md-3">Fecha de pago</dt>
                <dd class="col-md-9">
                    @Model.FechaPago.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-md-3">Método de pago</dt>
                <dd class="col-md-9">@Model.MetodoPago</dd>

                <dt class="col-md-3">Concepto</dt>
                <dd class="col-md-9">@Model.Concepto</dd>

                <dt class="col-md-3">Estado</dt>
                <dd class="col-md-9">
                    <span class="badge bg-success">@Model.Estado</span>
                </dd>
            </dl>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
            </div>
        </div>
    </div>
</div>

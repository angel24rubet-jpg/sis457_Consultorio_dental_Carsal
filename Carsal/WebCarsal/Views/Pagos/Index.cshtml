
@model IEnumerable<WebCarsal.Models.Pago>

@{
    ViewData["Title"] = "Pagos";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-cash-stack"></i> Gestión de Pagos</h2>
            <p class="text-muted mb-0">Administración de pagos realizados</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Registrar pago
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
            @if (TempData["TotalPago"] != null)
            {
                <br /> <strong>Total: Bs @TempData["TotalPago"]</strong>
            }
            @if (TempData["Cambio"] != null)
            {
                <br /> <strong>Cambio: Bs @TempData["Cambio"]</strong>
            }
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Paciente</th>
                            <th>CI</th>
                            <th>Monto</th>
                            <th>Método</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var pago in Model)
                        {
                            <tr>
                                <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @pago.IdCitaNavigation.IdPacienteNavigation.Nombres
                                    @pago.IdCitaNavigation.IdPacienteNavigation.PrimerApellido
                                    @pago.IdCitaNavigation.IdPacienteNavigation.SegundoApellido
                                </td>
                                <td>@pago.IdCitaNavigation.IdPacienteNavigation.Ci</td>
                                <td>Bs @pago.Monto.ToString("N2")</td>
                                <td>@pago.MetodoPago</td>
                                <td>
                                    <span class="badge bg-success">@pago.Estado</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@pago.Id"
                                       class="btn btn-sm btn-outline-info" title="Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No existen pagos registrados.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

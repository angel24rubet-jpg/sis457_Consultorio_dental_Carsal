@model IEnumerable<WebCarsal.Models.Pago>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IdCita)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaPago)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Monto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MetodoPago)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Concepto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioRegistro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioModificacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaModificacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DetallePago)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdCitaNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioModificacionNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioRegistroNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.IdCita)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaPago)
            </td>
            <td>
                @Html.DisplayFor(model => item.Monto)
            </td>
            <td>
                @Html.DisplayFor(model => item.MetodoPago)
            </td>
            <td>
                @Html.DisplayFor(model => item.Concepto)
            </td>
            <td>
                @Html.DisplayFor(model => item.Estado)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdUsuarioRegistro)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdUsuarioModificacion)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaModificacion)
            </td>
            <td>
                @Html.DisplayFor(model => item.DetallePago)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdCitaNavigation)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdUsuarioModificacionNavigation)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdUsuarioRegistroNavigation)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

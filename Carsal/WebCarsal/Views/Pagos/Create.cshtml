@model WebCarsal.Models.PagoFormViewModel

@{
    ViewData["Title"] = "Registrar pago";
}

<div class="container-fluid">
    <div class="mb-4">
        <h2><i class="bi bi-cash-stack"></i> Registrar pago</h2>
        <p class="text-muted">Busque al paciente, seleccione su cita atendida y agregue los servicios.</p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="mb-3">1. Buscar paciente</h5>

            <div class="row align-items-end">
                <div class="col-md-6 mb-2">
                    <label class="form-label" for="ci">Carnet de identidad</label>
                    <input type="text" id="ci" class="form-control"
                           placeholder="Ingrese el CI del paciente" autocomplete="off" />
                </div>
                <div class="col-md-3 mb-2">
                    <button type="button" id="btnBuscar" class="btn btn-primary">
                        <i class="bi bi-search"></i> Buscar paciente
                    </button>
                </div>
            </div>

            <div id="mensaje" class="mt-3"></div>
            <div id="datosPaciente" class="mt-3" style="display:none;"></div>
        </div>
    </div>

    <div class="card shadow-sm mb-4" id="contenedorCitas" style="display:none;">
        <div class="card-body p-4">
            <h5 class="mb-3">2. Seleccionar cita atendida</h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Seleccionar</th>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Doctor</th>
                            <th>Especialidad</th>
                        </tr>
                    </thead>
                    <tbody id="listaCitas"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4" id="contenedorServicios" style="display:none;">
        <div class="card-body p-4">
            <h5 class="mb-3">3. Agregar servicios</h5>

            <div class="row align-items-end">
                <div class="col-md-6 mb-2">
                    <label for="servicio" class="form-label">Servicio</label>
                    <select id="servicio" class="form-select">
                        <option value="">Seleccione un servicio</option>
                    </select>
                </div>

                <div class="col-md-2 mb-2">
                    <label for="cantidad" class="form-label">Cantidad</label>
                    <input type="number" id="cantidad" class="form-control"
                           value="1" min="1" max="100" />
                </div>

                <div class="col-md-3 mb-2">
                    <button type="button" id="btnAgregar" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Agregar servicio
                    </button>
                </div>
            </div>

            <div class="table-responsive mt-4">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Servicio</th>
                            <th>Precio unitario</th>
                            <th>Cantidad</th>
                            <th>Subtotal</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody id="listaServicios">
                        <tr id="filaVacia">
                            <td colspan="5" class="text-center text-muted">
                                Todavía no se agregaron servicios.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4" id="contenedorPago" style="display:none;">
        <div class="card-body p-4">
            <h5 class="mb-3">4. Información del pago</h5>

            <form asp-action="Create" method="post" id="formPago">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Ci" id="CiFormulario" />
                <input type="hidden" asp-for="IdPaciente" id="IdPaciente" />
                <input type="hidden" asp-for="IdCita" id="IdCita" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="MetodoPago" class="form-label"></label>
                        <select asp-for="MetodoPago" class="form-select" id="metodoPago">
                            <option value="">Seleccione el método de pago</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="QR">QR</option>
                        </select>
                        <span asp-validation-for="MetodoPago" class="text-danger"></span>
                    </div>
                </div>

                <div id="seccionEfectivo" style="display:none;">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="EfectivoRecibido" class="form-label"></label>
                            <input asp-for="EfectivoRecibido" type="number"
                                   min="0" step="0.01" class="form-control"
                                   id="efectivoRecibido" value="0" />
                            <span asp-validation-for="EfectivoRecibido" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label">Cambio a devolver</label>
                            <input type="text" id="cambio" class="form-control"
                                   value="Bs 0.00" readonly />
                        </div>
                    </div>
                </div>

                <div class="border rounded p-3 mb-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Total a cobrar</span>
                        <strong id="totalTexto">Bs 0.00</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Estado del pago</span>
                        <span class="badge bg-success">Pagado automáticamente</span>
                    </div>
                </div>

                <div id="camposDetalles"></div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary" id="btnGuardar">
                        <i class="bi bi-save"></i> Registrar pago
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const ci = document.getElementById("ci");
        const btnBuscar = document.getElementById("btnBuscar");
        const mensaje = document.getElementById("mensaje");
        const datosPaciente = document.getElementById("datosPaciente");
        const contenedorCitas = document.getElementById("contenedorCitas");
        const listaCitas = document.getElementById("listaCitas");
        const contenedorServicios = document.getElementById("contenedorServicios");
        const contenedorPago = document.getElementById("contenedorPago");
        const listaServicios = document.getElementById("listaServicios");
        const camposDetalles = document.getElementById("camposDetalles");

        let serviciosDisponibles = [];
        let serviciosAgregados = [];

        function limpiarResultados() {
            mensaje.innerHTML = "";
            datosPaciente.style.display = "none";
            datosPaciente.innerHTML = "";
            contenedorCitas.style.display = "none";
            listaCitas.innerHTML = "";
            contenedorServicios.style.display = "none";
            contenedorPago.style.display = "none";
            listaServicios.innerHTML = "";
            camposDetalles.innerHTML = "";
            serviciosAgregados = [];
            actualizarTotal();
        }

        async function buscarPaciente() {
            limpiarResultados();

            const valor = ci.value.trim();

            if (!valor) {
                mensaje.innerHTML =
                    '<div class="alert alert-warning">Ingrese el CI del paciente.</div>';
                return;
            }

            btnBuscar.disabled = true;
            btnBuscar.innerHTML = "Buscando...";

            try {
                const respuesta = await fetch(
                    '@Url.Action("BuscarPaciente", "Pagos")?ci=' +
                    encodeURIComponent(valor)
                );

                const datos = await respuesta.json();

                if (!datos.encontrado) {
                    mensaje.innerHTML =
                        `<div class="alert alert-warning">${datos.mensaje}</div>`;
                    return;
                }

                datosPaciente.innerHTML = `
                    <div class="alert alert-info mb-0">
                        <strong>Paciente:</strong> ${datos.paciente.nombre}<br>
                        <strong>CI:</strong> ${datos.paciente.ci}
                    </div>`;

                datosPaciente.style.display = "block";

                if (datos.citas.length === 0) {
                    mensaje.innerHTML =
                        `<div class="alert alert-warning">${datos.mensaje}</div>`;
                    return;
                }

                mensaje.innerHTML =
                    `<div class="alert alert-success">${datos.mensaje}</div>`;

                document.getElementById("IdPaciente").value = datos.paciente.id;
                document.getElementById("CiFormulario").value = datos.paciente.ci;

                datos.citas.forEach(cita => {
                    const fila = document.createElement("tr");

                    fila.innerHTML = `
                        <td>
                            <input type="radio" name="citaSeleccionada"
                                   value="${cita.id}" class="form-check-input">
                        </td>
                        <td>${cita.fecha}</td>
                        <td>${cita.hora}</td>
                        <td>${cita.doctor}</td>
                        <td>${cita.especialidad}</td>`;

                    listaCitas.appendChild(fila);
                });

                contenedorCitas.style.display = "block";

                document.querySelectorAll('input[name="citaSeleccionada"]')
                    .forEach(radio => {
                        radio.addEventListener("change", async function () {
                            document.getElementById("IdCita").value = this.value;
                            await cargarServicios();
                        });
                    });
            }
            catch {
                mensaje.innerHTML =
                    '<div class="alert alert-danger">No fue posible realizar la búsqueda.</div>';
            }
            finally {
                btnBuscar.disabled = false;
                btnBuscar.innerHTML =
                    '<i class="bi bi-search"></i> Buscar paciente';
            }
        }

        async function cargarServicios() {
            contenedorServicios.style.display = "none";
            contenedorPago.style.display = "none";
            listaServicios.innerHTML = "";
            serviciosAgregados = [];

            try {
                const respuesta = await fetch(
                    '@Url.Action("ObtenerServicios", "Pagos")'
                );

                serviciosDisponibles = await respuesta.json();

                const selector = document.getElementById("servicio");
                selector.innerHTML =
                    '<option value="">Seleccione un servicio</option>';

                serviciosDisponibles.forEach(s => {
                    selector.add(new Option(
                        `${s.nombre} - Bs ${Number(s.precio).toFixed(2)}`,
                        s.id
                    ));
                });

                contenedorServicios.style.display = "block";
                contenedorPago.style.display = "block";
                actualizarTabla();
            }
            catch {
                mensaje.innerHTML =
                    '<div class="alert alert-danger">No se pudieron cargar los servicios.</div>';
            }
        }

        document.getElementById("btnAgregar").addEventListener("click", function () {
            const id = Number(document.getElementById("servicio").value);
            const cantidad = Number(document.getElementById("cantidad").value);

            if (!id) {
                alert("Seleccione un servicio.");
                return;
            }

            if (!Number.isInteger(cantidad) || cantidad < 1 || cantidad > 100) {
                alert("Ingrese una cantidad válida entre 1 y 100.");
                return;
            }

            if (serviciosAgregados.some(s => s.id === id)) {
                alert("Este servicio ya fue agregado.");
                return;
            }

            const servicio = serviciosDisponibles.find(s => s.id === id);

            serviciosAgregados.push({
                id: servicio.id,
                nombre: servicio.nombre,
                precio: Number(servicio.precio),
                cantidad: cantidad
            });

            document.getElementById("servicio").value = "";
            document.getElementById("cantidad").value = 1;

            actualizarTabla();
        });

        function actualizarTabla() {
            listaServicios.innerHTML = "";

            if (serviciosAgregados.length === 0) {
                listaServicios.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            Todavía no se agregaron servicios.
                        </td>
                    </tr>`;
            }

            serviciosAgregados.forEach((s, index) => {
                const subtotal = s.precio * s.cantidad;
                const fila = document.createElement("tr");

                const nombre = document.createElement("td");
                nombre.textContent = s.nombre;

                const precio = document.createElement("td");
                precio.textContent = "Bs " + s.precio.toFixed(2);

                const cantidad = document.createElement("td");
                cantidad.textContent = s.cantidad;

                const importe = document.createElement("td");
                importe.textContent = "Bs " + subtotal.toFixed(2);

                const accion = document.createElement("td");
                const boton = document.createElement("button");
                boton.type = "button";
                boton.className = "btn btn-sm btn-outline-danger";
                boton.innerHTML = '<i class="bi bi-trash"></i>';
                boton.addEventListener("click", () => {
                    serviciosAgregados.splice(index, 1);
                    actualizarTabla();
                });

                accion.appendChild(boton);
                fila.append(nombre, precio, cantidad, importe, accion);
                listaServicios.appendChild(fila);
            });

            actualizarTotal();
            actualizarCamposDetalles();
        }

        function actualizarCamposDetalles() {
            camposDetalles.innerHTML = "";

            serviciosAgregados.forEach((s, index) => {
                const id = document.createElement("input");
                id.type = "hidden";
                id.name = `Detalles[${index}].IdServicio`;
                id.value = s.id;

                const cantidad = document.createElement("input");
                cantidad.type = "hidden";
                cantidad.name = `Detalles[${index}].Cantidad`;
                cantidad.value = s.cantidad;

                camposDetalles.append(id, cantidad);
            });
        }

        function actualizarTotal() {
            const total = serviciosAgregados.reduce(
                (suma, s) => suma + s.precio * s.cantidad, 0
            );

            document.getElementById("totalTexto").textContent =
                "Bs " + total.toFixed(2);

            actualizarCambio();
        }

        function actualizarCambio() {
            const total = serviciosAgregados.reduce(
                (suma, s) => suma + s.precio * s.cantidad, 0
            );

            const efectivo = Number(
                document.getElementById("efectivoRecibido").value
            ) || 0;

            const cambio = Math.max(0, efectivo - total);

            document.getElementById("cambio").value =
                "Bs " + cambio.toFixed(2);
        }

        document.getElementById("metodoPago").addEventListener("change", function () {
            const esEfectivo = this.value === "Efectivo";

            document.getElementById("seccionEfectivo").style.display =
                esEfectivo ? "block" : "none";

            if (!esEfectivo) {
                document.getElementById("efectivoRecibido").value = 0;
            }

            actualizarCambio();
        });

        document.getElementById("efectivoRecibido")
            .addEventListener("input", actualizarCambio);

        document.getElementById("formPago").addEventListener("submit", function (e) {
            if (!document.getElementById("IdCita").value) {
                e.preventDefault();
                alert("Seleccione una cita atendida.");
                return;
            }

            if (serviciosAgregados.length === 0) {
                e.preventDefault();
                alert("Agregue al menos un servicio.");
                return;
            }

            const metodo = document.getElementById("metodoPago").value;
            const total = serviciosAgregados.reduce(
                (suma, s) => suma + s.precio * s.cantidad, 0
            );

            const efectivo = Number(
                document.getElementById("efectivoRecibido").value
            ) || 0;

            if (!metodo) {
                e.preventDefault();
                alert("Seleccione el método de pago.");
                return;
            }

            if (metodo === "Efectivo" && efectivo < total) {
                e.preventDefault();
                alert("El efectivo recibido no puede ser menor al total.");
                return;
            }

            actualizarCamposDetalles();
        });

        btnBuscar.addEventListener("click", buscarPaciente);

        ci.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                buscarPaciente();
            }
        });
    </script>
}

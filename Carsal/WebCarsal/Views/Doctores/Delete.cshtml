@model WebCarsal.Models.Doctor

<style>
    .doctor-delete {
        color: #263F42;
    }

        .doctor-delete .modal-header {
            background: #FFFFFF;
            border-bottom: 1px solid #E5EEEE;
        }

        .doctor-delete .modal-title {
            color: #164B50;
            font-weight: 700;
        }

        .doctor-delete .delete-icon {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            background: #FCE8E8;
            color: #B64242;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
        }

        .doctor-delete .doctor-info {
            background: #F3F6F7;
            border: 1px solid #E5EEEE;
            border-radius: 10px;
            padding: 13px 15px;
            height: 100%;
        }

        .doctor-delete .info-label {
            display: block;
            color: #718586;
            font-size: .8rem;
            margin-bottom: 4px;
        }

        .doctor-delete .info-value {
            color: #263F42;
            font-weight: 600;
            font-size: .9rem;
            overflow-wrap: anywhere;
        }

        .doctor-delete .modal-footer {
            background: #FFFFFF;
            border-top: 1px solid #E5EEEE;
        }

        .doctor-delete .btn-cancelar {
            background: #F0F4F4;
            color: #263F42;
            border: 1px solid #DCE6E5;
            border-radius: 9px;
            padding: 9px 18px;
            font-weight: 600;
        }

            .doctor-delete .btn-cancelar:hover {
                background: #D9F3F0;
                color: #164B50;
            }

        .doctor-delete .btn-desactivar {
            background: #B64242;
            color: #FFFFFF;
            border: none;
            border-radius: 9px;
            padding: 9px 18px;
            font-weight: 600;
        }

            .doctor-delete .btn-desactivar:hover {
                background: #923333;
                color: #FFFFFF;
            }
</style>

<div class="doctor-delete">

    <div class="modal-header px-4 py-3">
        <div class="d-flex align-items-center gap-2">
            <div class="rounded-3 d-flex align-items-center justify-content-center"
                 style="width:42px;height:42px;background:#FCE8E8;color:#B64242;">
                <i class="bi bi-person-x fs-5"></i>
            </div>

            <div>
                <h5 class="modal-title mb-0">Desactivar doctor</h5>
                <small class="text-secondary">
                    Confirmación de desactivación
                </small>
            </div>
        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Cerrar"></button>
    </div>

    <div class="modal-body p-4">

        <div class="text-center mb-4">
            <div class="delete-icon">
                <i class="bi bi-exclamation-triangle fs-2"></i>
            </div>

            <h5 class="fw-bold" style="color:#164B50;">
                ¿Deseas desactivar este doctor?
            </h5>

            <p class="text-secondary mb-0">
                El registro se conservará en el sistema, pero el doctor dejará de estar activo.
            </p>
        </div>

        <div class="row g-3">

            <div class="col-md-6">
                <div class="doctor-info">
                    <span class="info-label">Carnet de identidad</span>
                    <span class="info-value">@Model.Ci</span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="doctor-info">
                    <span class="info-label">Nombres</span>
                    <span class="info-value">@Model.Nombres</span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="doctor-info">
                    <span class="info-label">Apellidos</span>
                    <span class="info-value">@Model.Apellidos</span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="doctor-info">
                    <span class="info-label">Especialidad</span>
                    <span class="info-value">
                        @(Model.IdEspecialidadNavigation?.Nombre ?? "No especificada")
                    </span>
                </div>
            </div>

        </div>

        <div class="alert mt-3 mb-0"
             style="background:#FFF5E8;color:#80551C;border:1px solid #F1DFC2;">
            <i class="bi bi-info-circle me-1"></i>
            No podrás desactivar al doctor si tiene citas pendientes o confirmadas.
        </div>

    </div>

    <div class="modal-footer px-4 py-3">

        <button type="button"
                class="btn btn-cancelar"
                data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i>
            Cancelar
        </button>

        <form asp-action="Delete"
              asp-controller="Doctores"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.Id" />

            <button type="submit" class="btn btn-desactivar">
                <i class="bi bi-person-x me-1"></i>
                Confirmar desactivación
            </button>

        </form>

    </div>

</div>

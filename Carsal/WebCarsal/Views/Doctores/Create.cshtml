@model WebCarsal.Models.DoctorFormViewModel

@{
    ViewData["Title"] = "Registrar doctor";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Registrar doctor</h2>
            <p class="text-muted mb-0">Ingrese los datos del profesional médico.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <h5 class="fw-bold mb-3">
                    <i class="bi bi-person-vcard text-primary"></i>
                    Información personal
                </h5>

                <div class="row g-3">

                    <div class="col-md-4">
                        <label asp-for="Ci" class="form-label"></label>
                        <input asp-for="Ci" class="form-control" placeholder="Carnet de identidad" />
                        <span asp-validation-for="Ci" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Nombres" class="form-label"></label>
                        <input asp-for="Nombres" class="form-control" placeholder="Nombres" />
                        <span asp-validation-for="Nombres" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Apellidos" class="form-label"></label>
                        <input asp-for="Apellidos" class="form-control" placeholder="Apellidos" />
                        <span asp-validation-for="Apellidos" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Celular" class="form-label"></label>
                        <input asp-for="Celular" class="form-control" placeholder="Número de celular" />
                        <span asp-validation-for="Celular" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Direccion" class="form-label"></label>
                        <input asp-for="Direccion" class="form-control" placeholder="Dirección" />
                        <span asp-validation-for="Direccion" class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <h5 class="fw-bold mb-3">
                    <i class="bi bi-award text-primary"></i>
                    Información profesional
                </h5>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="IdEspecialidad" class="form-label"></label>

                        <select asp-for="IdEspecialidad"
                                asp-items="ViewBag.IdEspecialidad"
                                class="form-select">
                            <option value="">Seleccione una especialidad...</option>
                        </select>

                        <span asp-validation-for="IdEspecialidad" class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-person-plus-fill"></i>
                        Registrar doctor
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@model IEnumerable<WebCarsal.Models.Doctor>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Ci)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombres)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Apellidos)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Celular)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Direccion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioRegistro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaRegistro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioModificacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaModificacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdEspecialidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cita)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdEspecialidadNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioModificacionNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioRegistroNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Usuario)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Ci)
            </td>
            <td>
                @Html.DisplayFor(model => item.Nombres)
            </td>
            <td>
                @Html.DisplayFor(model => item.Apellidos)
            </td>
            <td>
                @Html.DisplayFor(model => item.Celular)
            </td>
            <td>
                @Html.DisplayFor(model => item.Direccion)
            </td>
            <td>
                @Html.DisplayFor(model => item.Estado)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdUsuarioRegistro)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaRegistro)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdUsuarioModificacion)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaModificacion)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdEspecialidad)
            </td>
            <td>
                @Html.DisplayFor(model => item.Cita)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdEspecialidadNavigation)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdUsuarioModificacionNavigation)
            </td>
            <td>
                @Html.DisplayFor(model => item.IdUsuarioRegistroNavigation)
            </td>
            <td>
                @Html.DisplayFor(model => item.Usuario)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

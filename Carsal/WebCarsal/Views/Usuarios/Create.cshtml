@model WebCarsal.Models.UsuarioFormViewModel

@{
    ViewData["Title"] = "Registrar usuario";
}

<div class="container-fluid">
    <div class="mb-4">
        <h2>Registrar usuario</h2>
        <p class="text-muted">Complete los datos para crear una cuenta.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="NombreUsuario" class="form-label"></label>
                        <input asp-for="NombreUsuario" class="form-control"
                               placeholder="Ingrese el nombre de usuario" />
                        <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Clave" class="form-label"></label>
                        <input asp-for="Clave" class="form-control"
                               placeholder="Ingrese una contraseña" />
                        <span asp-validation-for="Clave" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Rol" class="form-label"></label>
                        <select asp-for="Rol" class="form-select" id="Rol">
                            <option value="">Seleccione un rol</option>
                            <option value="Administrador">Administrador</option>
                            <option value="Doctor">Doctor</option>
                        </select>
                        <span asp-validation-for="Rol" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3" id="contenedorDoctor">
                        <label asp-for="IdDoctor" class="form-label"></label>
                        <select asp-for="IdDoctor" class="form-select"
                                asp-items="ViewBag.Doctores">
                            <option value="">Seleccione un doctor</option>
                        </select>
                        <span asp-validation-for="IdDoctor" class="text-danger"></span>
                    </div>
                </div>

                <hr />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar usuario
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const rol = document.getElementById("Rol");
        const contenedorDoctor = document.getElementById("contenedorDoctor");
        const doctor = document.getElementById("IdDoctor");

        function mostrarDoctor() {
            if (rol.value === "Doctor") {
                contenedorDoctor.style.display = "block";
            } else {
                contenedorDoctor.style.display = "none";
                doctor.value = "";
            }
        }

        rol.addEventListener("change", mostrarDoctor);
        mostrarDoctor();
    </script>
}